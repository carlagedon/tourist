generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [vector, postgis]
}

enum LocationType {
  SIGHTSEEING 
  FOOD        
  HOTEL       
  ACTIVITY    
}

model Location {
  id             Int          @id @default(autoincrement())
  title          String       @unique
  type           LocationType
  
  priceValue     Float        @default(0.0) 
  isFree         Boolean      @default(false) 
  tags           LocationTag[]     
  
  shortContext   String       @db.Text
  loreContext    String       @db.Text
  
  embedding      Unsupported("vector(1024)")? 
  coords         Unsupported("geometry(Point, 4326)")
  
  routes         RouteLocation[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}


enum RouteStatus {
  DRAFT       
  COMPLETED  
  CANCELLED   
}

model Message {
  id        Int         @id @default(autoincrement())
  chatId    String
  chat      ChatSession @relation(fields: [chatId], references: [id], onDelete: Cascade)
  
  role      MessageRole      
  text      String      @db.Text 
  
  createdAt DateTime    @default(now())
}

enum MessageRole {
  USER
  ASSISTANT
}

model Route {
  id          Int             @id @default(autoincrement())
  title       String          
  startCity   String          
  totalCost   Float           @default(0.0)
  status      RouteStatus     @default(DRAFT)

  locations   RouteLocation[] 
  chats       ChatSession[]   

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ChatSession {
  id        String    @id @default(uuid())
  title     String?   
  
  routeId   Int?       
  route     Route?     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  
  messages  Message[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model RouteLocation {
  id          Int      @id @default(autoincrement())
  routeId     Int
  locationId  Int
  
  route       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  arrivalTime     String? 
  durationMinutes Int?     
  
  stepOrder   Int      
  aiNote      String?  @db.Text 

  @@unique([routeId, locationId])
}

enum LocationTag {
  NATURE
  LAKE
  MEAT
  FAMILY
  ACTIVE
  HISTORY
  CHEAP
  LUXURY
}